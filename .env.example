# Docker Model Runner (OpenAI-compatible)
LLM_BASE_URL=http://model-runner.docker.internal:12434/engines/llama.cpp/v1
LLM_MODEL=huggingface.co/bartowski/mistral-7b-instruct-v0.3-gguf:q4_k_m
LLM_API_KEY=no-key

# Embeddings (HuggingFace local)
EMBEDDINGS_MODEL=huggingface.co/gpustack/bge-m3-gguf

# Reranking model settings
LLM_RERANKING_BASE_URL=http://model-runner.docker.internal:12434/engines/llama.cpp/v1
LLM_RERANKING_MODEL=huggingface.co/gpustack/bge-reranker-v2-m3-gguf
LLM_RERANKING_MODEL_ALIAS=model-bge-reranker

# API
API_HOST=0.0.0.0
API_PORT=8000

# DOCKER settings
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# CHUNCKING settings
CHUNCKING_MAX_TOKENS=450
CHUNKING_OVERLAP_TOKENS=50

# VectorDB settings
COLLECTION_NAME=rag_cnaps
# --- Mode HTTP (Docker) ---
CHROMA_HOST=chromadb          # hostname du service Docker ChromaDB (vide = mode local)
CHROMA_PORT=8000               # port interne ChromaDB dans le container
CHROMA_RETRIES=5               # tentatives de connexion au démarrage
CHROMA_BACKOFF=1.0             # délai initial entre tentatives (exponentiel, en secondes)
# --- Mode local (dev sans Docker) ---
VECTOR_DB_DIR=./vector_cnaps_db  # utilisé uniquement si CHROMA_HOST est vide



# Configuration Cache 
XDG_CACHE_HOME=/tmp/.cache
HF_HOME=/tmp/.cache
RAPIDOCR_CACHE=/tmp/.cache/rapidocr_models