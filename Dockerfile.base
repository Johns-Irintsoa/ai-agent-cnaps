# syntax=docker/dockerfile:1 
FROM img-torch-base AS builder

WORKDIR /build

# Dépendances système pour la compilation (pas de torch/torchvision ici)
RUN echo 'Acquire::http::Timeout "30";' > /etc/apt/apt.conf.d/99timeout \
    && apt-get update && apt-get install -y \
        build-essential \
        libmagic-dev \
        libtesseract-dev \
        libpoppler-cpp-dev \
        gcc \
        g++ \
        --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Création de l'environnement virtuel (optionnel mais cohérent)
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Configuration PIP
ENV PIP_DEFAULT_TIMEOUT=1000 \
    PIP_RETRIES=20 \
    PIP_NO_CACHE_DIR=0

RUN pip install --upgrade pip --quiet

# ============================================
# Installation des autres dépendances Python
# (sans torch/torchvision, déjà présents dans l'image de base)
# ============================================

RUN pip install --no-cache-dir numpy scipy

RUN pip install --no-cache-dir \
    fastapi uvicorn[standard] python-dotenv 'redis>=5.0.0'

RUN pip install --no-cache-dir \
    'chromadb>=0.5.20' \
    'langchain-chroma>=1.0.0' \
    langchain-community \
    langchain-core \
    langchain-openai \
    langchain-text-splitters \
    langchain-classic

RUN pip install --no-cache-dir \
    docling 'unstructured[image]' pypdf python-docx pdf2image \
    pytesseract opencv-python pillow pymupdf rarfile

RUN pip install --no-cache-dir \
    httpx==0.27.2 beautifulsoup4==4.12.3 python-multipart \
    transformers pydantic-settings \
    rank_bm25>=0.2.2

# Vérification que docling s'importe (torch est déjà là)
RUN python -c "from docling.document_converter import DocumentConverter; print('Docling importé avec succès !')"

# ============================================
# Stage runtime
# ============================================
FROM python:3.11-slim

RUN useradd -m -u 1000 appuser

RUN echo "deb http://deb.debian.org/debian bookworm non-free" >> /etc/apt/sources.list \
    && apt-get update && apt-get install -y \
        p7zip-full unrar tesseract-ocr tesseract-ocr-fra \
        poppler-utils libmagic1 libtesseract5 libpoppler-cpp2 \
        libgl1 libglib2.0-0 libgomp1 wget \
        --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app

RUN mkdir -p /home/appuser/.cache/docling /home/appuser/.cache/huggingface \
    && chown -R appuser:appuser /home/appuser/.cache \
    && chown -R appuser:appuser /opt/venv \
    && chown -R appuser:appuser /home/appuser \
    && chown -R appuser:appuser /app

# Copie du code source et des fichiers nécessaires
COPY src/ /app/src/
COPY cnaps_urls.json /app/
COPY entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh \
    && chown -R appuser:appuser /app /entrypoint.sh

USER appuser

ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "src.api.app:app", "--host", "0.0.0.0", "--port", "8000"]